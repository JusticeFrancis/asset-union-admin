# Application
APP_URL=http://localhost:3000
NODE_ENV=development
AUTH_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-a-different-long-random-secret
CRON_SECRET=replace-with-a-long-random-cron-secret

# Optional. Leave blank when frontend and API are served by the same Next.js app.
NEXT_PUBLIC_API_URL=
# Legacy UI preview override only. Leave blank in production; database roles are authoritative.
NEXT_PUBLIC_ADMIN_ROLE=

# MongoDB
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/asset-union-admin?retryWrites=true&w=majority

# First super admin (created only when the Admin collection is empty)
SUPER_ADMIN_NAME=Justice Francis
SUPER_ADMIN_EMAIL=cjfrancisf@gmail.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

# Gmail SMTP (use a Google App Password, never your normal Gmail password)
GMAIL_USER=cjfrancisf@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_FROM=Asset Union <cjfrancisf@gmail.com>

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Bridge.xyz
BRIDGE_API_KEY=
BRIDGE_BASE_URL=https://api.bridge.xyz/v0
# Leave BRIDGE_CUSTOMER_ID blank to generate a separate business KYB onboarding flow per property.
# Set it only when intentionally using one already-approved Bridge customer for all property virtual accounts.
BRIDGE_CUSTOMER_ID=
BRIDGE_BUSINESS_EMAIL=cjfrancisf@gmail.com
BRIDGE_DESTINATION_WALLET_ADDRESS=
BRIDGE_DESTINATION_CURRENCY=usdc
BRIDGE_DESTINATION_RAIL=base
BRIDGE_DEVELOPER_FEE_PERCENT=

# doola Partner API for LLC formation/legal documents
DOOLA_API_KEY=
DOOLA_BASE_URL=https://api.test.doola.com
DOOLA_WEBHOOK_SECRET=
DOOLA_FORMATION_STATE=WY
DOOLA_INDUSTRY=Lessors of Residential Buildings and Dwellings
# Optional responsible-party fallbacks. Property-specific values entered in the wizard take precedence.
DOOLA_OWNER_FULL_NAME=
DOOLA_OWNER_EMAIL=cjfrancisf@gmail.com
DOOLA_OWNER_PHONE=
DOOLA_OWNER_COUNTRY=USA
DOOLA_OWNER_ADDRESS_LINE1=
DOOLA_OWNER_ADDRESS_LINE2=
DOOLA_OWNER_CITY=
DOOLA_OWNER_STATE=
DOOLA_OWNER_POSTAL_CODE=
DOOLA_OWNER_ADDRESS_COUNTRY=USA
